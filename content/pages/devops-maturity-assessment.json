            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Manually, and it takes a while"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Mostly automated"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "One command, identical every time"
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "t": "panel",
         "cls": "glass q-block",
         "blocks": [
          {
           "t": "text",
