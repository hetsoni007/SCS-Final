            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "About an hour"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Minutes, manually"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Automatic rollback in minutes"
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "t": "panel",
         "cls": "glass q-block",
         "blocks": [
          {
           "t": "text",
           "html": "07 · Security",
           "cls": "qn"
          },
          {
           "t": "h",
           "level": 3,
           "html": "Where does security sit in your pipeline?"
