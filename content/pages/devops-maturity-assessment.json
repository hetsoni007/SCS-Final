         "t": "panel",
         "cls": "glass q-block",
         "blocks": [
          {
           "t": "text",
           "html": "01 · Delivery",
           "cls": "qn"
          },
          {
           "t": "h",
           "level": 3,
           "html": "How often do you deploy to production?"
          },
          {
           "t": "grid",
           "cls": "opt-col",
           "items": [
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Less than once a month"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Roughly monthly"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Weekly"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "On demand — multiple times a day"
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "t": "panel",
         "cls": "glass q-block",
         "blocks": [
          {
           "t": "text",
           "html": "02 · CI/CD",
           "cls": "qn"
          },
          {
           "t": "h",
           "level": 3,
           "html": "How automated is your build &amp; release?"
          },
          {
           "t": "grid",
           "cls": "opt-col",
           "items": [
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Mostly manual steps"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Some build scripts"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Automated builds, manual deploys"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Fully automated CI/CD with rollbacks"
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "t": "panel",
         "cls": "glass q-block",
         "blocks": [
          {
           "t": "text",
           "html": "03 · Infrastructure",
           "cls": "qn"
          },
          {
           "t": "h",
           "level": 3,
           "html": "How is your infrastructure managed?"
