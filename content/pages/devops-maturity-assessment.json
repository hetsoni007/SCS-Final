           "t": "grid",
           "cls": "opt-col",
           "items": [
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Users tell us"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "We dig through logs"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Dashboards and some alerts"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Metrics, logs, traces + SLOs"
              }
             ]
            }
           ]
          }
