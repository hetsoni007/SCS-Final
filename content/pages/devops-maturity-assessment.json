          {
           "t": "grid",
           "cls": "opt-col",
           "items": [
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Not formally addressed"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Occasional manual reviews"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Some automated scanning"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Scans + secrets management (DevSecOps)"
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "t": "panel",
         "cls": "glass q-block",
         "blocks": [
          {
           "t": "text",
