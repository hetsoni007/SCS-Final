             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "We glance at the monthly bill"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Tagging and budgets in place"
              }
             ]
            },
            {
             "cls": "opt-pill",
             "blocks": [
              {
               "t": "text",
               "html": "Right-sizing, savings plans, FinOps"
              }
             ]
            }
           ]
          }
         ]
        }
