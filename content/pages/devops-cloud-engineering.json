  {
   "@context": "https://schema.org",
   "@type": "FAQPage",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "What does a DevOps & cloud engagement include?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "It depends on where you are. Common scope: setting up CI/CD pipelines, containerising apps and moving them to Kubernetes, codifying infrastructure with Terraform, migrating to or optimising AWS/Azure, and adding observability so you can catch issues before users do. We scope it on a short call and propose a fixed plan."
     }
    },
    {
     "@type": "Question",
     "name": "Do you work with both AWS and Azure?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes. We design and operate on both AWS and Azure (and the surrounding ecosystem — Docker, Kubernetes, Terraform, GitHub Actions, Prometheus and Grafana). We pick the stack that fits your team and workloads, not the one we want to sell."
     }
    },
    {
     "@type": "Question",
     "name": "Can you reduce our cloud bill?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Usually, yes. Most teams over-provision compute, leave idle resources running and miss savings plans. A cloud cost audit identifies the waste; right-sizing, autoscaling and IaC guardrails keep it from coming back. Try our cloud cost calculator for an indicative estimate."
     }
    },
    {
     "@type": "Question",
     "name": "How do you set up CI/CD pipelines?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "We build automated pipelines (GitHub Actions, GitLab CI, Jenkins or Azure DevOps) that test, security-scan, build and deploy on every commit — with safe rollbacks. The goal is push-button, low-risk releases so your team ships daily instead of monthly."
     }
    },
    {
     "@type": "Question",
     "name": "Do you support mobile CI/CD for React Native apps?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Yes — automated React Native release pipelines with Fastlane and EAS, signed builds, App Store and Play Store submission, and over-the-air updates. It ties directly into our React Native app development practice."
     }
    },
    {
     "@type": "Question",
     "name": "How quickly can you start?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Most engagements begin within a week of a scoping call. A focused cloud cost audit or CI/CD setup can show results in the first couple of weeks."
     }
    }
   ]
