# Copy to .env.local for local development; set the same keys in Vercel → Project → Settings → Environment Variables.
# Nothing here is required to run the site. Without delivery keys, forms log to the server console in development
# and show a "please email us" error in production.

# ── Forms (server action: app/actions/lead.ts) ───────────────────────────────────────────────
# Email delivery through Resend.
RESEND_API_KEY=
LEAD_TO_EMAIL=het.soni@soniconsultancyservices.com
# Must be an address on a domain verified in Resend, e.g. "Soni Consultancy <website@soniconsultancyservices.com>"
LEAD_FROM_EMAIL=
# Optional CRM / automation webhook. Receives { kind, name, email, …fields, page, utm_* } as JSON.
# The live site's lead API accepts this same payload shape, so you can point this at it to keep that pipeline.
LEAD_WEBHOOK_URL=
# Accept submissions without delivering them (used by the Playwright suite and for previews).
LEAD_DRY_RUN=

# ── Anti-spam: Cloudflare Turnstile (optional; the honeypot and rate limit are always on) ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────────────────────
# GA4 measurement ID. Loaded only after the visitor accepts analytics cookies. The live site uses G-0J9H7CBX0Q.
NEXT_PUBLIC_GA_ID=
# Vercel Analytics needs no key; enable it in the Vercel project. It is included automatically in builds that run
# on Vercel. Hosting elsewhere behind a Vercel-compatible proxy? Set ANALYTICS=vercel at build time.
# ANALYTICS=vercel

# ── Optional AI assistant demo on /ai-app-development/ (off unless both flags are "true") ─────
ASSISTANT_ENABLED=false
NEXT_PUBLIC_ASSISTANT_ENABLED=false
# Read by the Anthropic SDK. Create a key at https://console.anthropic.com/ and set a monthly spend limit.
ANTHROPIC_API_KEY=
