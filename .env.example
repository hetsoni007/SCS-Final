# Copy to .env.local for local development (these are build-time values; there is no server on the S3 deployment).
# Nothing here is required to run the site. Without NEXT_PUBLIC_LEAD_ENDPOINT, forms log a dry run to the console.

# ── Forms (lib/lead.ts) ──────────────────────────────────────────────────────────────────────
# Build-time URL of the lead API (API Gateway → the scs-lead-mailer Lambda). The browser POSTs
# { kind, name, email, …fields, page, utm_* } to it. Leave it empty in dev, tests and previews: forms then accept
# the submission without sending it anywhere. The live site's endpoint is set by scripts/deploy-aws.sh.
NEXT_PUBLIC_LEAD_ENDPOINT=

# ── Analytics ────────────────────────────────────────────────────────────────────────────────
# GA4 measurement ID. Loaded only after the visitor accepts analytics cookies. The live site uses G-0J9H7CBX0Q.
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container ID (GTM-XXXXXXX). Loaded in <head> for every visitor with Consent Mode: storage is
# denied until the visitor accepts analytics cookies. Give non-Google tags a consent requirement inside the container.
# Do not add a GA4 tag for the measurement ID above inside the container: the site already sends it, and page views
# would be counted twice. The live site uses GTM-MQXMVJZW.
NEXT_PUBLIC_GTM_ID=
# ── Form spam protection ─────────────────────────────────────────────────────
# Cloudflare Turnstile SITE key (public). When set, every lead form shows the check and sends its token; the lead
# API verifies it once the Lambda has TURNSTILE_SECRET. The site's CSP must allow https://challenges.cloudflare.com
# in script-src and frame-src. Leave empty to switch the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Vercel Analytics needs no key; enable it in the Vercel project. It is included automatically in builds that run
# on Vercel. Hosting elsewhere behind a Vercel-compatible proxy? Set ANALYTICS=vercel at build time.
# ANALYTICS=vercel

# ── Optional AI assistant demo on /ai-app-development/ (off unless both flags are "true") ─────
ASSISTANT_ENABLED=false
NEXT_PUBLIC_ASSISTANT_ENABLED=false
# Read by the Anthropic SDK. Create a key at https://console.anthropic.com/ and set a monthly spend limit.
ANTHROPIC_API_KEY=

# ── Inquiry funnel (Phase 1) ─────────────────────────────────────────────────────────────────
# Owner WhatsApp number, digits with country code. Build-time and public (not a secret). Keep it empty here: scripts/deploy-aws.sh
# builds production with 918160682185 unless NEXT_PUBLIC_WHATSAPP_NUMBER is set. Empty => wa.me opens WhatsApp's contact picker.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Reply promise shown on /thanks. Build-time and public. scripts/deploy-aws.sh builds with "within 1 business day" unless this is set.
NEXT_PUBLIC_REPLY_PROMISE=
# POST /inquiry (API Gateway -> Lambda scs-inquiry, source in backend/inquiry). Defaults to NEXT_PUBLIC_LEAD_ENDPOINT + "/inquiry".
NEXT_PUBLIC_INQUIRY_ENDPOINT=
# "true" lets the inquiry form accept and log a submission without sending it when no endpoint is configured (tests, previews).
# Build-time. Outside production builds the dry run is always on; a production build without this flag and without an endpoint reports a send failure.
# The deploy script clears it and refuses to upload a dist that contains the dry-run path.
NEXT_PUBLIC_INQUIRY_DRY_RUN=
