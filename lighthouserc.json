{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3100",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/services/",
        "http://localhost:3100/work/",
        "http://localhost:3100/ai-app-development/",
        "http://localhost:3100/devops-cloud-engineering/",
        "http://localhost:3100/app-cost-calculator/",
        "http://localhost:3100/contact/",
        "http://localhost:3100/blog/",
        "http://localhost:3100/blog/react-native-app-development-cost",
        "http://localhost:3100/privacy/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports"
    }
  }
}
